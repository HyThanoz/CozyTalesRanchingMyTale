items.CozyRanch_Feed_Hearty.name=Alimento abundante
items.CozyRanch_Feed_Hearty.description=Una mezcla de granos y papa que llena bien. Los animales se mantienen bien alimentados por más tiempo. Ponlo en un comedero o dáselo en la mano.
items.CozyRanch_Feed_Sweet.name=Alimento dulce
items.CozyRanch_Feed_Sweet.description=Golosinas de zanahoria y calabaza. Por un rato, los animales te toman confianza más rápido. Ponlo en un comedero o dáselo en la mano.
items.CozyRanch_Feed_Breeders.name=Alimento para criadores
items.CozyRanch_Feed_Breeders.description=Verduras frescas que preparan a los animales para volver a criar antes. Ponlo en un comedero o dáselo en la mano.
items.CozyRanch_Feed_Premium.name=Alimento premium
items.CozyRanch_Feed_Premium.description=Lo mejor de la cosecha. Por un rato, los animales producen un poco más. Ponlo en un comedero o dáselo en la mano.
items.CozyRanch_Toy_Ball.name=Pelota
items.CozyRanch_Toy_Ball.description=Una pelota blanda para empujar. A los cerdos les encanta.
items.CozyRanch_Toy_ScratchingPost.name=Poste para rascar
items.CozyRanch_Toy_ScratchingPost.description=Un poste resistente para rascarse a gusto. A las vacas y a las ovejas les encanta.
items.CozyRanch_Toy_HangingBell.name=Campana colgante
items.CozyRanch_Toy_HangingBell.description=Una campanita para picotear y hacer sonar. A las gallinas les encanta.
items.CozyRanch_Toy_FloatingDuck.name=Pato flotante
items.CozyRanch_Toy_FloatingDuck.description=Un pato de madera que flota en el estanque. A las ranas les encanta.
items.CozyRanch_Toy_Log.name=Tronco para trepar
items.CozyRanch_Toy_Log.description=Un tronco con musgo para sentarse y saltar. A las ranas les encanta.
